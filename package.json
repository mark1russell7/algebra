{
  "$schema": "https://json.schemastore.org/package",
  "name": "algebra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:actions && pnpm run test:rules",
    "test:actions": "node --test \".github/actions/*.test.ts\"",
    "test:rules": "node --test \"scripts/*.test.ts\"",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.4.1",
    "@mark1russell7/boundaries": "^0.2.0",
    "@mark1russell7/conventions": "^0.38.1",
    "@mark1russell7/cue": "^2.1.1",
    "@mark1russell7/ste-lint": "^0.3.0",
    "@mark1russell7/template-cli": "^0.1.4",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "apiReport": {
    "packages": [
      "packages/*",
      "!packages/*-bench",
      "!packages/bigfloat",
      "!packages/evaluator-select",
      "!packages/expression",
      "!packages/expression-corpus",
      "!packages/polynomial",
      "!packages/predicate-census",
      "!packages/site"
    ],
    "includePrivate": true
  }
}
