    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
