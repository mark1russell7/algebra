{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/linear",
  "version": "0.1.2",
  "description": "Exact linear algebra and linear programs over exact rationals: solve, rank, null space, a two-phase simplex with the rule of Bland, lexicographic objectives, integer programs by branch and bound, and certificates with a check.",
  "keywords": [
    "linear-algebra",
    "linear-programming",
    "simplex",
    "exact-arithmetic",
    "rational",
    "certificate",
    "farkas",
    "duality",
    "integer-programming",
    "branch-and-bound"
  ],
  "homepage": "https://github.com/mark1russell7/algebra/tree/main/packages/linear#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/algebra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/algebra.git",
    "directory": "packages/linear"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-helper.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rational": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
