{
  "$schema": "https://json.schemastore.org/package",
  "name": "@algebra/evaluator-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The bench of A6: the cost and the error of each evaluator and of the stitched plan on the corpus of A12, with the paired times of rigor-bench.",
