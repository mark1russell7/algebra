  },
  "dependencies": {
    "@algebra/evaluator-select": "workspace:*",
    "@algebra/expression-corpus": "workspace:*",
    "@mark1russell7/expression": "workspace:*",
    "@mark1russell7/rational": "workspace:*",
    "@mark1russell7/rigor-bench": "^0.2.3",
    "@mark1russell7/rigor-statistics": "^0.1.5"
  }
