{
  "$schema": "https://json.schemastore.org/package",
  "name": "@algebra/predicates-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The bench of the time claim of A5: the predicates of @mark1russell7/predicates against robust-predicates, with the paired times of rigor-bench.",
  "main": "./src/index.ts",
  "scripts": {
    "bench": "node src/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/predicates": "workspace:*",
    "@mark1russell7/rigor-bench": "^0.2.29",
    "robust-predicates": "^3.0.3"
  }
}
