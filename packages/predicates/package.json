{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/predicates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exact geometric predicates for float inputs: orientation, in-circle and segment intersection. A float filter with a stated bound answers first, and an exact dyadic sign answers the rest.",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/expression": "workspace:*",
    "@mark1russell7/rational": "workspace:*",
    "@types/node": "^26.6.5",
    "robust-predicates": "^3.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
