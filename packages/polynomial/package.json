{
  "$schema": "https://json.schemastore.org/package",
  "name": "@algebra/polynomial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The symbolic evaluator of A8: the canonical normal form of a polynomial and of a rational function with exact rational coefficients, and the solution of linear and polynomial equations with a stated error.",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@algebra/expression-corpus": "workspace:*",
    "@mark1russell7/cue": "^2.1.1",
    "@mark1russell7/rigor-generators": "^0.1.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/coeval": "^0.34.0",
    "@mark1russell7/expression": "workspace:*",
    "@mark1russell7/rational": "workspace:*"
  }
}
